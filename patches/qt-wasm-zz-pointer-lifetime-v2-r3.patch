+void QWasmWindow::handlePointerEnterLeaveEvent(const PointerEvent &event,
+                                              const QWasmPointerContext &context)
+{
+    if (processPointerEnterLeave(event, context))
+        event.webEvent.call<void>("preventDefault");
+}
+
+bool QWasmWindow::processPointerEnterLeave(const PointerEvent &event,
+                                          const QWasmPointerContext &context)
+{
+    const unsigned status = fcwebPointerStatus(context);
+    fcwebPointerTrace(context, 140, 0, status);
+    if (fcwebPointerBlocked(context))
+        return false;
+    if (event.pointerType != PointerType::Mouse && event.pointerType != PointerType::Pen)
+        return false;
+
+    switch (event.type) {
+    case EventType::PointerEnter: {
+        const auto coordinates = fcwebPointerCoordinates(event, context);
+        if (!coordinates)
+            return false;
+        const auto pointInScreen = coordinates->pointInScreen;
+        if (fcwebPointerScreenBlocked(context, coordinates->screen,
+                reinterpret_cast<quintptr>(coordinates->platformScreen)))
+            return false;
+        QWindowSystemInterface::handleEnterEvent(
+                context.window.data(), mapFromGlobal(pointInScreen.toPoint()), pointInScreen);
+        break;
+    }
+    case EventType::PointerLeave:
+        QWindowSystemInterface::handleLeaveEvent(context.window.data());
+        break;
+    default:
+        break;
+    }
+
+    return false;
+}
+
+void QWasmWindow::releasePointerGrab(const MouseEvent &event,
+                                    const QWasmPointerContext &context)
+{
+    if (fcwebPointerBlocked(context))
+        return;
+    const auto capturedPointerId = m_capturedPointerId;
+    if (!capturedPointerId)
+        return;
+    const emscripten::val eventWindow = m_window;
+    const bool targeted = event.isTargetedForElement(eventWindow);
+    if (fcwebPointerBlocked(context) || !targeted)
+        return;
+    const bool captured = eventWindow.call<bool>("hasPointerCapture", *capturedPointerId);
+    if (fcwebPointerBlocked(context) || !captured)
+        return;
+    eventWindow.call<void>("releasePointerCapture", *capturedPointerId);
+    if (fcwebPointerBlocked(context))
+        return;
+    m_capturedPointerId = std::nullopt;
+}
+
+void QWasmWindow::processPointer(const PointerEvent &event,
+                               const QWasmPointerContext &context)
+{
+    unsigned status = fcwebPointerStatus(context);
+    fcwebPointerTrace(context, 100, 0, status);
+    if (fcwebPointerBlocked(context))
+        return;
+
+    // Process pointer events targeted at the window only, and not
+    // for instance events for the accessibility elements.
+    const bool targeted = event.isTargetedForElement(m_window);
+    status = fcwebPointerStatus(context);
+    fcwebPointerTrace(context, 101, 0, status);
+    if (fcwebPointerBlocked(context) || !targeted)
+        return;
+
+    switch (event.type) {
+    case EventType::PointerDown:
+        m_capturedPointerId = event.pointerId;
+        fcwebPointerTrace(context, 102, 0, 0);
+        if (fcwebPointerBlocked(context))
+            return;
+        m_window.call<void>("setPointerCapture", event.pointerId);
+        status = fcwebPointerStatus(context);
+        fcwebPointerTrace(context, 103, 0, status);
+        if (fcwebPointerBlocked(context))
+            return;
+
+        if ((window()->flags() & Qt::WindowDoesNotAcceptFocus)
+                    != Qt::WindowDoesNotAcceptFocus
+            && window()->isTopLevel()) {
+            fcwebPointerTrace(context, 104, 0, status);
+            if (fcwebPointerBlocked(context))
+                return;
+            window()->requestActivate();
+            status = fcwebPointerStatus(context);
+            fcwebPointerTrace(context, 105, 0, status);
+            if (fcwebPointerBlocked(context))
+                return;
+        }
+        break;
+    case EventType::PointerUp:
+        fcwebPointerTrace(context, 106, 0, status);
+        if (fcwebPointerBlocked(context))
+            return;
+        releasePointerGrab(event, context);
+        status = fcwebPointerStatus(context);
+        fcwebPointerTrace(context, 107, 0, status);
+        if (fcwebPointerBlocked(context))
+            return;
+        break;
+    default:
+        break;
+    };
+
+    bool diagnosticBlocked = false;
+    fcwebPointerTrace(context, 108, 0, fcwebPointerStatus(context));
+    if (fcwebPointerBlocked(context))
+        return;
+    const bool eventAccepted = deliverPointerEvent(event, context, &diagnosticBlocked);
+    status = fcwebPointerStatus(context);
+    fcwebPointerTrace(context, 109, 0, status);
+    if (diagnosticBlocked || fcwebPointerBlocked(context))
+        return;
+
+    if (!eventAccepted && event.type == EventType::PointerDown) {
+        fcwebPointerTrace(context, 110, 0, status);
+        if (fcwebPointerBlocked(context))
+            return;
+        QGuiApplicationPrivate::instance()->closeAllPopups();
+        fcwebPointerTrace(context, 111, 0, fcwebPointerStatus(context));
+    }
+
+    if (eventAccepted) {
+        event.webEvent.call<void>("preventDefault");
+        event.webEvent.call<void>("stopPropagation");
+    }
+    fcwebPointerTrace(context, 112, 0, fcwebPointerStatus(context));
+}
