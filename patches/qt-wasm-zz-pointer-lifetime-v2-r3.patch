+bool QWasmWindow::deliverPointerEvent(const PointerEvent &event,
+                                    const QWasmPointerContext &context, bool *diagnosticBlocked)
+{
+    const auto coordinates = fcwebPointerCoordinates(event, context);
+    if (!coordinates) {
+        *diagnosticBlocked = true;
+        return false;
+    }
+    const auto pointInScreen = coordinates->pointInScreen;
+    const auto geometryF = coordinates->geometry;
+    QWasmScreen *const screen = coordinates->platformScreen;
+    if (fcwebPointerScreenBlocked(context, coordinates->screen,
+            reinterpret_cast<quintptr>(screen))) {
+        *diagnosticBlocked = true;
+        return false;
+    }
+    const QPointF targetPointClippedToScreen(
+            qBound(geometryF.left(), pointInScreen.x(), geometryF.right()),
+            qBound(geometryF.top(), pointInScreen.y(), geometryF.bottom()));
